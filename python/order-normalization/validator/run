#!/usr/bin/env python3
import copy
import importlib.util
import sys
from pathlib import Path


ASSERTION = sys.argv[1] if len(sys.argv) > 1 else ""
CANDIDATE = Path("/candidate/src/order_normalizer.py")


def normalize(event):
    import json
    import subprocess
    completed = subprocess.run([sys.executable, "/validator/worker.py"], input=json.dumps(event),
                               text=True, capture_output=True, timeout=30)
    if completed.returncode != 0:
        raise AssertionError(f"Candidate terminated abnormally ({completed.returncode}): {completed.stderr}")
    response = json.loads(completed.stdout)
    return response["result"], response["event"]


def sample_event():
    return {
        "order_id": "ORD-1001",
        "currency": "gbp",
        "lines": [
            {"sku": " widget ", "quantity": 2, "unit_price": "10.01"},
            {"sku": "GADGET", "quantity": 1, "unit_price": "5.50"},
            {"sku": "WIDGET", "quantity": 3, "unit_price": "10.01"},
            {"sku": "ignored", "quantity": 0, "unit_price": "99.99"},
        ],
    }


def assert_duplicate_lines():
    result = normalize(sample_event())[0]
    assert result["lines"] == [
        {"sku": "GADGET", "quantity": 1, "unit_price_cents": 550},
        {"sku": "WIDGET", "quantity": 5, "unit_price_cents": 1001},
    ], f"unexpected normalized lines: {result['lines']!r}"
    assert result["total_cents"] == 5555, result


    for first, later, expected_cents in [("1.005", "8.00", 101), ("8.00", "1.005", 800)]:
        event = {
            "order_id": "ORD-MIXED",
            "currency": "usd",
            "lines": [
                {"sku": "ABC", "quantity": 0, "unit_price": "99.99"},
                {"sku": " abc ", "quantity": 2, "unit_price": first},
                {"sku": "ABC", "quantity": 3, "unit_price": later},
            ],
        }
        result = normalize(event)[0]
        assert result["lines"] == [{"sku": "ABC", "quantity": 5, "unit_price_cents": expected_cents}], result
        assert result["total_cents"] == 5 * expected_cents, result


def assert_decimal_cents():
    event = {
        "order_id": "ORD-ROUND",
        "currency": "usd",
        "lines": [
            {"sku": "ROUND", "quantity": 2, "unit_price": "1.005"},
            {"sku": "EXACT", "quantity": 1, "unit_price": "2.25"},
        ],
    }
    result = normalize(event)[0]
    assert result["lines"][0]["unit_price_cents"] == 225, result
    assert result["lines"][1]["unit_price_cents"] == 101, result
    assert result["total_cents"] == 427, result


def assert_metadata_and_input_stability():
    event = sample_event()
    original = copy.deepcopy(event)
    result, after = normalize(event)
    assert after == original, "normalize_order must not mutate the input event"
    assert result["order_id"] == "ORD-1001", result
    assert result["currency"] == "GBP", result


ASSERTIONS = {
    "duplicate-lines": assert_duplicate_lines,
    "decimal-cents": assert_decimal_cents,
    "metadata-and-input-stability": assert_metadata_and_input_stability,
}


if ASSERTION not in ASSERTIONS:
    print(f"Unknown assertion {ASSERTION}", file=sys.stderr)
    sys.exit(2)

try:
    ASSERTIONS[ASSERTION]()
except Exception as exc:
    print(str(exc), file=sys.stderr)
    sys.exit(1)
