{
  "schemaVersion": "1.0",
  "challengeId": "order-normalization-python",
  "challengeVersion": "1.1.0",
  "title": "Order event normalization",
  "prompt": {
    "path": "prompt.md",
    "sha256": "4d7b31df8d3ed929d705f74804b39b137332ccdb925899f910fbc9741f8e7779"
  },
  "workspace": {
    "type": "git-bundle",
    "path": "workspace/starter.bundle",
    "sha256": "70acd2f4cd76d220e0606a554519d5089070e71110a7772ed066d58fe02fcb44",
    "baseCommit": "94b46f92cbfc9da8d93970b2b7fb015a08b6bd38"
  },
  "validation": {
    "image": {
      "type": "build",
      "contextPath": "validator",
      "containerfilePath": "validator/Containerfile",
      "contextSha256": "012784d5c3313fa49c8a0777ec7b1549a14e4769b8badb6cdc6e6433c19e1b25"
    },
    "workspacePath": "/candidate",
    "assertions": [
      {
        "id": "duplicate-lines",
        "title": "Duplicate SKU lines are normalized and combined",
        "classification": "requirement",
        "required": true,
        "command": [
          "/validator/run",
          "duplicate-lines"
        ],
        "workingDirectory": "/candidate",
        "timeoutSeconds": 120
      },
      {
        "id": "decimal-cents",
        "title": "Decimal prices are rounded to integer cents",
        "classification": "requirement",
        "required": true,
        "command": [
          "/validator/run",
          "decimal-cents"
        ],
        "workingDirectory": "/candidate",
        "timeoutSeconds": 120
      },
      {
        "id": "metadata-and-input-stability",
        "title": "Metadata is preserved and input is not mutated",
        "classification": "regression",
        "required": true,
        "command": [
          "/validator/run",
          "metadata-and-input-stability"
        ],
        "workingDirectory": "/candidate",
        "timeoutSeconds": 120
      }
    ]
  },
  "selfChecks": [
    {
      "id": "public-order-normalizer-tests",
      "title": "Run the public order normalizer tests",
      "command": [
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      "workingDirectory": ".",
      "timeoutSeconds": 120
    }
  ],
  "limits": {
    "targetTimeoutSeconds": 1800,
    "validatorTimeoutSeconds": 600
  }
}
