{
  "schemaVersion": "1.0",
  "challengeId": "order-normalization-python",
  "challengeVersion": "1.0.0",
  "title": "Order event normalization",
  "prompt": {
    "path": "prompt.md",
    "sha256": "5ba1cf09c3e5672ecd839f330dc50ba400d8b4bf79fc1c8c755be899f3e2a22d"
  },
  "workspace": {
    "type": "git-bundle",
    "path": "workspace/starter.bundle",
    "sha256": "029a83196be5d29e22698b37e1a2c94baefdd22154359b9fe704576f5dc5dc15",
    "baseCommit": "03c867cc77d78300765197e837b95c7e9342cf0c"
  },
  "validation": {
    "image": {
      "type": "build",
      "contextPath": "validator",
      "containerfilePath": "validator/Containerfile",
      "contextSha256": "b275424cebd27aa7f82487cd7932b2d222b7272d0160ad60eaab97324e5dbdff"
    },
    "workspacePath": "/candidate",
    "assertions": [
      {
        "id": "duplicate-lines",
        "title": "Duplicate SKU lines are normalized and combined",
        "classification": "requirement",
        "required": true,
        "command": [
          "/validator/run",
          "duplicate-lines"
        ],
        "workingDirectory": "/candidate",
        "timeoutSeconds": 120
      },
      {
        "id": "decimal-cents",
        "title": "Decimal prices are rounded to integer cents",
        "classification": "requirement",
        "required": true,
        "command": [
          "/validator/run",
          "decimal-cents"
        ],
        "workingDirectory": "/candidate",
        "timeoutSeconds": 120
      },
      {
        "id": "metadata-and-input-stability",
        "title": "Metadata is preserved and input is not mutated",
        "classification": "regression",
        "required": true,
        "command": [
          "/validator/run",
          "metadata-and-input-stability"
        ],
        "workingDirectory": "/candidate",
        "timeoutSeconds": 120
      }
    ]
  },
  "selfChecks": [
    {
      "id": "public-order-normalizer-tests",
      "title": "Run the public order normalizer tests",
      "command": [
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      "workingDirectory": ".",
      "timeoutSeconds": 120
    }
  ],
  "limits": {
    "targetTimeoutSeconds": 1800,
    "validatorTimeoutSeconds": 600
  }
}
