{
  "schemaVersion": "1.0",
  "challengeId": "idempotent-processing-dotnet",
  "challengeVersion": "1.0.0",
  "title": "Idempotent command processing",
  "prompt": {
    "path": "prompt.md",
    "sha256": "6ddfa14d884f20cf8e4545fdf963c589708b00f9cbcded2807770b4fe2f3721e"
  },
  "workspace": {
    "type": "git-bundle",
    "path": "workspace/starter.bundle",
    "sha256": "5d81ac16a8017200252080dd637efedcb1ddaeda0f0c22d3896e0bdd93da2782",
    "baseCommit": "aaff9f7eae85c3021c310c5f30eb16c56fad605d"
  },
  "validation": {
    "image": {
      "type": "build",
      "contextPath": "validator",
      "containerfilePath": "validator/Containerfile",
      "contextSha256": "c2cd30f0eddaf6e92ac49aa4506900e5a724414da52a016dcffa529d4ea5326e"
    },
    "workspacePath": "/candidate",
    "assertions": [
      {
        "id": "duplicate-delivery",
        "title": "Duplicate delivery applies the transition once",
        "classification": "requirement",
        "required": true,
        "command": [
          "/validator/run",
          "duplicate-delivery"
        ],
        "workingDirectory": "/candidate",
        "timeoutSeconds": 120
      },
      {
        "id": "concurrent-delivery",
        "title": "Concurrent duplicate delivery is safe",
        "classification": "requirement",
        "required": true,
        "command": [
          "/validator/run",
          "concurrent-delivery"
        ],
        "workingDirectory": "/candidate",
        "timeoutSeconds": 120
      },
      {
        "id": "distinct-commands",
        "title": "Distinct commands still update balances",
        "classification": "regression",
        "required": true,
        "command": [
          "/validator/run",
          "distinct-commands"
        ],
        "workingDirectory": "/candidate",
        "timeoutSeconds": 120
      }
    ]
  },
  "selfChecks": [
    {
      "id": "public-command-processor-tests",
      "title": "Run the public command processor tests",
      "command": [
        "dotnet",
        "test",
        "src/CommandProcessor.Tests/CommandProcessor.Tests.csproj"
      ],
      "workingDirectory": ".",
      "timeoutSeconds": 120
    }
  ],
  "limits": {
    "targetTimeoutSeconds": 1800,
    "validatorTimeoutSeconds": 600
  }
}
