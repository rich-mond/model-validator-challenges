diff --git a/src/OrderSearch/OrderSearchRequest.cs b/src/OrderSearch/OrderSearchRequest.cs
new file mode 100644
index 0000000..8e81773
--- /dev/null
+++ b/src/OrderSearch/OrderSearchRequest.cs
@@ -0,0 +1,47 @@
+using System.Globalization;
+
+namespace OrderSearch;
+
+public sealed record OrderSearchRequest(OrderStatus? Status, DateTimeOffset? CreatedFrom,
+    DateTimeOffset? CreatedTo, int Page, int PageSize)
+{
+    public static bool TryParse(IQueryCollection query, out OrderSearchRequest? request)
+    {
+        request = null;
+        if (!Integer(query, "page", 1, out int page) || page < 1 ||
+            !Integer(query, "pageSize", 20, out int size) || size is < 1 or > 50)
+            return false;
+        OrderStatus? status = null;
+        if (query.TryGetValue("status", out var value))
+        {
+            if (!Enum.TryParse<OrderStatus>(value.ToString(), true, out var parsed) ||
+                !Enum.IsDefined(parsed) || int.TryParse(value.ToString(), out _)) return false;
+            status = parsed;
+        }
+        if (!Timestamp(query, "createdFrom", out var from) ||
+            !Timestamp(query, "createdTo", out var to) || from > to) return false;
+        request = new(status, from, to, page, size);
+        return true;
+    }
+
+    private static bool Integer(IQueryCollection query, string key, int fallback, out int value)
+    {
+        value = fallback;
+        return !query.TryGetValue(key, out var text) || int.TryParse(text.ToString(), NumberStyles.None,
+            CultureInfo.InvariantCulture, out value);
+    }
+
+    private static bool Timestamp(IQueryCollection query, string key, out DateTimeOffset? value)
+    {
+        value = null;
+        if (!query.TryGetValue(key, out var text)) return true;
+        string[] formats = ["yyyy-MM-dd'T'HH:mm:ss'Z'", "yyyy-MM-dd'T'HH:mm:ss.FFFFFFF'Z'",
+            "yyyy-MM-dd'T'HH:mm:sszzz", "yyyy-MM-dd'T'HH:mm:ss.FFFFFFFzzz"];
+        if (!DateTimeOffset.TryParseExact(text.ToString(), formats, CultureInfo.InvariantCulture,
+                DateTimeStyles.AssumeUniversal, out var result) || result.Offset != TimeSpan.Zero) return false;
+        value = result;
+        return true;
+    }
+}
+
+public sealed record OrderPage(IReadOnlyList<OrderDto> Items, long Total, int Page, int PageSize);
