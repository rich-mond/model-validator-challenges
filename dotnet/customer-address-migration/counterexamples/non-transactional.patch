+using Microsoft.Data.Sqlite;
+
+namespace CustomerAddresses;
+
+public sealed class AddressRepository(CustomerDatabase database)
+{
+    public IReadOnlyList<CustomerAddress> ForCustomer(string customerId)
+    {
+        using var connection = database.Open();
+        using var command = Sql.Command(connection, null, """
+            SELECT id,customer_id,line1,city,postal_code,country_code,is_primary
+            FROM customer_addresses WHERE customer_id=$customer ORDER BY id
+            """, ("$customer", customerId));
+        using var reader = command.ExecuteReader();
+        List<CustomerAddress> result = [];
+        while (reader.Read())
+        {
+            result.Add(new(reader.GetString(0), reader.GetString(1), reader.GetString(2),
+                reader.GetString(3), reader.GetString(4), reader.GetString(5), reader.GetBoolean(6)));
+        }
+        return result;
+    }
+
+    public CustomerAddress Add(string customerId, Address address, bool makePrimary = false)
+    {
+        AddressRules.Validate(address);
+        using var connection = database.Open();
+        using var transaction = connection.BeginTransaction();
+        using var exists = Sql.Command(connection, transaction,
+            "SELECT COUNT(*) FROM customers WHERE id=$id", ("$id", customerId));
+        if ((long)exists.ExecuteScalar()! == 0)
+            throw new ArgumentException("Unknown customer.", nameof(customerId));
+        using var count = Sql.Command(connection, transaction,
+            "SELECT COUNT(*) FROM customer_addresses WHERE customer_id=$id", ("$id", customerId));
+        bool primary = makePrimary || (long)count.ExecuteScalar()! == 0;
+        if (primary)
+            Sql.Execute(connection, transaction, "UPDATE customer_addresses SET is_primary=0 WHERE customer_id=$id", ("$id", customerId));
+        string id = Guid.NewGuid().ToString("N");
+        Sql.Execute(connection, transaction, """
+            INSERT INTO customer_addresses(id,customer_id,line1,city,postal_code,country_code,is_primary)
+            VALUES($id,$customer,$line,$city,$postal,$country,$primary)
+            """, ("$id", id), ("$customer", customerId), ("$line", address.Line1),
+            ("$city", address.City), ("$postal", address.PostalCode), ("$country", address.CountryCode), ("$primary", primary));
+        transaction.Commit();
+        return new(id, customerId, address.Line1, address.City, address.PostalCode, address.CountryCode, primary);
+    }
+
+    public bool SetPrimary(string customerId, string addressId)
+    {
+        using var connection = database.Open();
+        using var transaction = connection.BeginTransaction();
+        using var exists = Sql.Command(connection, transaction,
+            "SELECT COUNT(*) FROM customer_addresses WHERE customer_id=$customer AND id=$id",
+            ("$customer", customerId), ("$id", addressId));
+        if ((long)exists.ExecuteScalar()! == 0) return false;
+        Sql.Execute(connection, transaction, "UPDATE customer_addresses SET is_primary=0 WHERE customer_id=$customer", ("$customer", customerId));
+        Sql.Execute(connection, transaction, "UPDATE customer_addresses SET is_primary=1 WHERE id=$id", ("$id", addressId));
+        transaction.Commit();
+        return true;
+    }
+}
